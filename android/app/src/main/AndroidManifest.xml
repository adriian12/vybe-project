<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Enlaces directos: un QR o un enlace compartido de vybe abre la
                 aplicacion instalada en vez del navegador. Requiere publicar
                 /.well-known/assetlinks.json en el dominio; hasta entonces el
                 sistema abrira el navegador, sin romper nada. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="@string/deep_link_host" />
            </intent-filter>

            <!-- Esquema propio, como respaldo: funciona sin dominio ni
                 verificacion, y es lo que usan los enlaces de los correos
                 cuando el sistema no reconoce el dominio. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="vybe" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permisos -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        Cámara: la foto del evento y las del perfil se hacen en el momento.
        `android.hardware.camera` va como opcional para no dejar fuera de la
        tienda a las tabletas sin cámara trasera.
    -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!--
        Ubicación: sin ella no se puede comprobar que alguien está de verdad en
        el local, que es lo que sostiene todo el producto. Se pide la precisa
        porque las geocercas son de cincuenta metros y la aproximada no llega.
    -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Avisos. Desde Android 13 hay que pedirlo explícitamente. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Galería, sólo para las fotos de perfil de quien tiene Premium. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
</manifest>
