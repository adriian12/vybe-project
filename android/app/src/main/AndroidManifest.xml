<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Enlaces directos: un enlace compartido de app.vybes.es (una
                 fiesta, un perfil, el correo de verificacion) abre la aplicacion
                 instalada en vez del navegador. Solo las rutas de clubber: el
                 panel de local y el de administracion siguen en el navegador.
                 Requiere publicar /.well-known/assetlinks.json con la huella de
                 la clave de firma; hasta entonces se abre el navegador. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="@string/deep_link_host" />
                <data android:pathPrefix="/event/" />
                <data android:pathPrefix="/u/" />
                <data android:pathPrefix="/chat/" />
                <data android:pathPrefix="/matches" />
                <data android:pathPrefix="/home" />
                <data android:pathPrefix="/auth/verify-email" />
                <data android:pathPrefix="/auth/reset-password" />
            </intent-filter>

            <!-- Esquema propio, como respaldo: funciona sin dominio ni
                 verificacion, y es lo que usan los enlaces de los correos
                 cuando el sistema no reconoce el dominio. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="vybe" />
            </intent-filter>

        </activity>

        <!-- Selector de fotos del sistema también en Android 11 y 12: Google
             Play instala el módulo compatible la primera vez que hace falta. -->
        <service
            android:name="com.google.android.gms.metadata.ModuleDependencies"
            android:enabled="false"
            android:exported="false"
            tools:ignore="MissingClass">
            <intent-filter>
                <action android:name="com.google.android.gms.metadata.MODULE_DEPENDENCIES" />
            </intent-filter>
            <meta-data android:name="photopicker_activity:0:required" android:value="" />
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permisos -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        Cámara: la foto del evento y las del perfil se hacen en el momento.
        `android.hardware.camera` va como opcional para no dejar fuera de la
        tienda a las tabletas sin cámara trasera.
    -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!--
        Ubicación: sin ella no se puede comprobar que alguien está de verdad en
        el local, que es lo que sostiene todo el producto. Se pide la precisa
        porque las geocercas son de cincuenta metros y la aproximada no llega.
    -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Avisos. Desde Android 13 hay que pedirlo explícitamente. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        Galería (fotos de perfil de Premium): desde Capacitor 8 la cámara usa el
        selector de fotos del sistema, que no necesita permiso. Google Play sólo
        admite READ_MEDIA_IMAGES en apps cuya función principal son las fotos, así
        que no se pide.
    -->
</manifest>
