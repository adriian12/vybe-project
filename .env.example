# ============================================================================
# Vybe — variables de entorno
# Copia este archivo a .env.local (cliente) y sube los secretos de servidor a
# Supabase con `supabase secrets set NOMBRE=valor`. Ver SETUP.md.
# ============================================================================

# ----------------------------------------------------------------------------
# CLIENTE — Vite sólo inyecta las VITE_*. Acaban en el bundle público.
# ----------------------------------------------------------------------------
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key

# Clave PÚBLICA de VAPID. Genera el par con: npx web-push generate-vapid-keys
# VITE_VAPID_PUBLIC_KEY=

# DSN de Sentry: es público por diseño.
# VITE_SENTRY_DSN=

# Sólo si envías la analítica a un proveedor externo en vez de a la Edge
# Function analytics-collect del propio proyecto.
# VITE_ANALYTICS_URL=

# Servicio externo de verificación facial. Sin él se usa la detección del
# navegador (FaceDetector) más comprobaciones de calidad de imagen.
# VITE_FACE_VERIFICATION_URL=

# Dominio público de la web (sin barra final). Lo usan los enlaces que se
# comparten desde la aplicación instalada, donde el origen es https://localhost.
# Es el dominio de las App Links / Universal Links.
# VITE_SITE_URL=https://app.vybes.es

# Qué se sirve en cada dominio (src/lib/hosts.ts): la landing en
# VITE_LANDING_URL y la web de locales y administración en VITE_APP_URL. En
# localhost y en las previews de Vercel se ve todo.
# VITE_LANDING_URL=https://vybes.es
# VITE_APP_URL=https://app.vybes.es

# Mapa: CARTO exige clave (gratuita, 5 M de teselas al mes). Se pide en
# https://carto.com/basemaps/apikey. Sin ella el mapa sale sin teselas.
# Ojo: NO es el «API Access Token» del Workspace de CARTO (empieza por eyJ).
# Ese token da acceso a los datos de la cuenta y todo lo que empieza por VITE_
# acaba dentro de la web y del APK.
# VITE_CARTO_API_KEY=

# «Continuar con Google» en la app instalada: IDs de cliente OAuth de Google
# Cloud (web e iOS; no son secretos). Vacíos, el botón no sale. El secreto del
# cliente web va sólo en Supabase (Authentication → Providers → Google).
# VITE_GOOGLE_WEB_CLIENT_ID=
# VITE_GOOGLE_IOS_CLIENT_ID=

# Enlaces a las tiendas. Vacíos, la landing muestra «Próximamente».
# VITE_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.vybe.app
# VITE_APP_STORE_URL=https://apps.apple.com/app/idXXXXXXXXXX

# ----------------------------------------------------------------------------
# SERVIDOR — `supabase secrets set …`. Nunca en el cliente.
# ----------------------------------------------------------------------------

# --- Push (send-push) -------------------------------------------------------
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:tu@email.com
# PUSH_HOOK_SECRET=            # cadena aleatoria, compartida con el webhook

# --- Moderación de fotos (moderate-photo) -----------------------------------
# SIGHTENGINE_USER=
# SIGHTENGINE_SECRET=
# MODERATION_THRESHOLD=0.6

# --- SMS (send-sms-verification y send-sos-alert) ---------------------------
# Se prefiere una API Key (SK…), que es revocable sin rotar las credenciales
# maestras de la cuenta. El Auth Token es la alternativa.
# TWILIO_ACCOUNT_SID=AC…
# TWILIO_API_KEY_SID=SK…
# TWILIO_API_KEY_SECRET=
# TWILIO_FROM_NUMBER=+34600000000
# TWILIO_AUTH_TOKEN=           # sólo si no usas API Key

# --- Correo de las alertas SOS (send-sos-alert) -----------------------------
# RESEND_API_KEY=
# RESEND_WEBHOOK_SECRET=   # "signing secret" del webhook de Resend, para
#   saber que correos rebotan (Resend > Webhooks > la funcion resend-webhook)
# SOS_FROM_EMAIL=onboarding@resend.dev   # sin dominio verificado en Resend
# AUTH_FROM_EMAIL=                       # remitente del correo de verificacion
#   onboarding@resend.dev SOLO entrega al correo del dueno de la cuenta de
#   Resend. Para escribir a cualquier persona hay que verificar un dominio
#   en Resend y poner aqui una direccion suya.

# --- Pagos (stripe-checkout y stripe-webhook) -------------------------------
# STRIPE_SECRET_KEY=
# STRIPE_PRICE_MONTHLY=
# STRIPE_PRICE_EVENT=
# STRIPE_PRICE_LIFETIME=
# Planes de local: dos precios recurrentes mensuales en Stripe.
# STRIPE_PRICE_VENUE_PRO=
# STRIPE_PRICE_VENUE_BUSINESS=
# STRIPE_WEBHOOK_SECRET=       # lo da Stripe al crear el endpoint
# APP_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Firebase Cloud Messaging — avisos en la aplicación de Android e iOS
#
# Los navegadores reciben los avisos por Web Push (las claves VAPID de arriba).
# Un teléfono con la aplicación instalada sólo acepta lo que venga de Firebase,
# y para eso hace falta una cuenta de servicio.
#
# Se saca de: consola de Firebase > Configuración del proyecto >
# Cuentas de servicio > Generar nueva clave privada. Descarga un JSON con estos
# tres campos.
#
# La clave privada lleva saltos de línea; al pegarla aquí quedan como 

# literales y el código los vuelve a convertir.
#
# Son secretos de las Edge Functions de Supabase, no de la web: NO van en
# Vercel. Van comentados para que Vercel no los proponga al importar.
# ---------------------------------------------------------------------------
# FCM_PROJECT_ID=
# FCM_CLIENT_EMAIL=
# FCM_PRIVATE_KEY=

# Token de la cuenta de Supabase que aloja Vybe, para el CLI
# (npm run secrets:push / functions:deploy). Se crea en
# https://supabase.com/dashboard/account/tokens
# Va aqui y no en $env: porque $env: solo dura lo que dura la ventana.
# SUPABASE_ACCESS_TOKEN=sbp_...

# Contraseña de las cuentas de prueba de scripts/generate-seed.py (mínimo 8 caracteres)
# SEED_PASSWORD=

# Correo que recibe las solicitudes de demo de la landing (Edge Function venue-lead)
# LEADS_NOTIFY_EMAIL=
